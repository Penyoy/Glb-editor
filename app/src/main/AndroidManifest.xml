<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Tidak ada izin yang diminta. Membuka berkas .glb memakai Storage Access Framework,
      yang memberi akses hanya ke berkas yang benar-benar dipilih pengguna.
    -->
    <application
        android:name=".Anima3dApplication"
        android:allowBackup="true"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.Anima3D">

        <!--
          configChanges dipasang supaya memutar layar tidak membuat ulang Activity.
          Kalau Activity dibuat ulang, permukaan render dan seluruh engine Filament
          ikut hancur dan model harus dimuat ulang dari awal.
        -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density|uiMode"
            android:exported="true"
            android:theme="@style/Theme.Anima3D">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
